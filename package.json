{
  "name": "@local/dsh-archctrl",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Architecture control for DeepSeek Harness: the .archctrl contract tree as a visual, checkable design layer.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/",
    "locale/",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/build-host.mjs",
    "build:client": "vite build",
    "build:host": "node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:ui": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write src test",
    "check": "npm run typecheck && npm run test && npm run test:ui",
    "verify": "npm run check && npm run build",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
